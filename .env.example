# Opzionale. Se manca, il predictor legge ../telegram-offerte-sconto/.env
# (stesso bot delle offerte: TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID).

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Cartella alternativa del bot offerte, se non è accanto a questo repo:
# OFFERTE_NOTIFICATIONS_DIR=

# Cloud (GitHub Actions): stessi valori come secret del repo.
# TELEGRAM_BOT_TOKEN
# TELEGRAM_CHAT_ID
# BETFAIR_APP_KEY, BETFAIR_USERNAME, BETFAIR_PASSWORD
# Promemoria Telegram il 1° di ogni mese: tocca il repo (commit o issue)
# altrimenti GitHub spegne gli schedule dopo 60 giorni.

# Betfair Exchange (quote live ATP/WTA per value bet)

# Archive Sackmann (zip da github.com/Aneeshers/tennis-sackmann-archive — contiene atp/ e wta/)
SACKMANN_ARCHIVE_PATH=lib/tennis-sackmann-archive-main

# Percorsi singoli (opzionali, sovrascrivono archive):
# SACKMANN_ATP_PATH=lib/tennis-sackmann-archive-main/atp
# SACKMANN_WTA_PATH=lib/tennis-sackmann-archive-main/wta

# Match Charting Project (Jeff Sackmann)
MCP_CHARTING_PATH=lib/tennis_MatchChartingProject-master

# InfoTennis scraper (atptour.com / Infosys API)
INFOTENNIS_PATH=lib/infotennis-main

# Seeder (TennisExplorer crawler) — opzionale
SEEDER_PATH=lib/seeder-main
SEEDER_DB_CONN_STR=sqlite:///lib/seeder-main/seeder.db

# Finestra validazione live (200-300 match BCR Pinnacle): 1=forza freeze, 0=disattiva manualmente.
# Senza override, il freeze si spegne da solo a 200+ pick Pinnacle settle (validation_freeze.json).
LIVE_VALIDATION_FREEZE=1
